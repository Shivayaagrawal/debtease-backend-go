	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Auto-authenticate if token is missing",
					"const token = pm.environment.get('accessToken');",
					"const email = pm.environment.get('email');",
					"const password = pm.environment.get('password');",
					"",
					"// Only auto-login if token is missing and credentials are available",
					"// Skip for auth endpoints to avoid infinite loops",
					"const url = pm.request.url.toString();",
					"const isAuthEndpoint = url.includes('/api/login') || url.includes('/api/register');",
					"",
					"if (!token && !isAuthEndpoint && email && password) {",
					"    pm.sendRequest({",
					"        url: pm.environment.get('baseUrl') + '/api/login',",
					"        method: 'POST',",
					"        header: { 'Content-Type': 'application/json' },",
					"        body: {",
					"            mode: 'raw',",
					"            raw: JSON.stringify({",
					"                email: email,",
					"                password: password",
					"            })",
					"        }",
					"    }, function (err, res) {",
					"        if (!err && res && res.code === 200) {",
					"            const body = res.json();",
					"            if (body && body.token) {",
					"                pm.environment.set('accessToken', body.token);",
					"            }",
					"            if (body && body.id) {",
					"                pm.environment.set('userId', body.id);",
					"            }",
					"            if (body && body.refresh_token) {",
					"                pm.environment.set('refreshToken', body.refresh_token);",
					"            }",
					"        }",
					"    });",
					"}"
				]
			}
		},
		{
			"listen": "test",
			"script": {
				"type": "text/javascript",
				"exec": [
					"// Global test script - runs after each request",
					"pm.test('Response time is less than 5000ms', function () {",
					"    pm.expect(pm.response.responseTime).to.be.below(5000);",
					"});"
				]
			}
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8080",
			"type": "string"
		}
	]
